DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gawen_db?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gawen_auth_test?schema=public"

TRUST_PROXY_HOPS=0
# Cloudflare R2 S3-compatible endpoint, bucket, and server-side credentials.
R2_ENDPOINT= 
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL configured for image delivery; never put storage credentials here.
R2_PUBLIC_BASE_URL=
